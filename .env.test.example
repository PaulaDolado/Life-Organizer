# Plantilla de .env.test — copia a .env.test y ajusta si tu Postgres local usa otro
# usuario/puerto. IMPORTANTE: el nombre de la base de datos debe contener "test"
# (tests/setupEnv.ts lo comprueba y aborta si no) porque los tests de integración
# borran todos los datos en cada test.

DATABASE_URL="postgresql://postgres:admin@localhost:5433/life_organizer_test"

PORT=3001
NODE_ENV=test

JWT_SECRET="test-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="*"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
