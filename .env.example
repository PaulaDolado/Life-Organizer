# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_organizer"

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="cambia-este-secreto-refresh-en-produccion"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
