// Life Organizer API — Prisma schema
// Ver: Life_Organizer_API_Especificacion.docx, sección 4

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String // bcrypt hash
  name         String
  timezone     String   @default("Europe/Madrid")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events        Event[]
  goals         Goal[]
  goalProgress  GoalProgress[]
  transactions  Transaction[]
  savingsGoals  SavingsGoal[]
  projects      Project[]
  hobbies       Hobby[]
  hobbySessions HobbySession[]
  notifications Notification[]
  tasks         Task[]
  notes         Note[]
  habits        Habit[]
  habitLogs     HabitLog[]
  syncTombstones SyncTombstone[]
}

model Event {
  id               Int      @id @default(autoincrement())
  userId           Int
  title            String
  description      String?
  type             String // "work", "study", "gym", "meeting", "free"
  startTime        DateTime
  endTime          DateTime
  location         String?
  isRecurring      Boolean  @default(false)
  recurringPattern String? // "weekly", "biweekly", "monthly"
  // Antelación(es) de aviso, en minutos (p.ej. [15, 1440] = 15 min y 1 día antes). Sustituye el
  // recordatorio fijo de ~30 min que antes generaba `notificationService` para todos los eventos
  // por igual — cada evento configura los suyos, y puede tener varios o ninguno ([]).
  reminderMinutesBefore Int[] @default([30])
  // Invitados: lista simple de nombres/emails sin flujo de invitación/aceptación (la app sigue
  // siendo mono-usuario) — solo para llevar constancia de quién viene al evento.
  guests           String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exceptions EventException[]

  @@index([userId])
  @@index([userId, startTime])
}

// Excepción a UNA ocurrencia concreta de una serie recurrente — mover o cancelar esa ocurrencia
// sin tocar el resto de la serie ni la plantilla. `originalStartTime` es el startTime que
// `expandRecurringEvent` habría calculado para ella de no existir la excepción; sirve de
// identificador estable de "qué ocurrencia es" incluso después de moverla (ver utils/recurrence.ts).
// Único (eventId, originalStartTime): como mucho una excepción por ocurrencia — pasar de "moved"
// a "cancelled" es un update sobre la misma fila, no una fila nueva.
model EventException {
  id                Int       @id @default(autoincrement())
  eventId           Int
  originalStartTime DateTime
  status            String // "moved" | "cancelled"
  newStartTime      DateTime?
  newEndTime        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStartTime])
  @@index([eventId])
}

model Goal {
  id           Int      @id @default(autoincrement())
  userId       Int
  title        String
  description  String?
  period       String // "weekly" | "monthly"
  targetValue  Int // meta numérica (ej: 7 días, 20 horas)
  currentValue Int      @default(0)
  completed    Boolean  @default(false)
  bonusPoints  Int      @default(10) // puntos si completa
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  periodStart  DateTime
  periodEnd    DateTime
  // Se pone a true cuando pasa `periodEnd` sin completarse (la archiva el scheduler de
  // src/jobs/goalExpiryScheduler.ts). Distinto de `completed`: una meta puede expirar sin
  // completarse, o completarse antes de expirar.
  expired      Boolean  @default(false)
  // Si es true (default), al expirar se crea automáticamente la meta del siguiente periodo
  // con los mismos datos (título, targetValue, etc.) y progreso en cero — así no hay que
  // recrear a mano "ejercicio 5 días" cada semana.
  autoRenew    Boolean  @default(true)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress GoalProgress[]

  @@index([userId])
  @@index([periodEnd, expired])
}

model GoalProgress {
  id     Int      @id @default(autoincrement())
  goalId Int
  userId Int
  value  Int // valor agregado hoy
  date   DateTime @default(now())
  note   String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String // "income" | "expense"
  amount      Decimal  @db.Decimal(12, 2)
  category    String // "salary", "food", "transport", "entertainment", etc.
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model SavingsGoal {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String // "Ahorro Vacaciones", "Fondo Emergencia"
  type          String    @default("ahorro") // "ahorro" | "inversion" — puramente de agrupación/visualización
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  category      String // para filtrar transacciones que cuenten
  // Valor de cada "casilla" en la vista de progreso (ej. 100€ por casilla). Puramente de
  // presentación: no afecta al cálculo de currentAmount (que sigue siendo la suma de
  // transacciones de `category`) — solo determina cuántas casillas se dibujan y cuánto
  // aporta cada clic.
  stepAmount    Decimal   @default(100) @db.Decimal(12, 2)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  status      String // "idea", "en_curso", "pausado", "completado"
  priority    String // "low", "medium", "high"
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks ProjectTask[]
  pages ProjectPage[]
  // Tareas del Planificador (tablero kanban) vinculadas a este proyecto — distinto de `tasks`
  // (ProjectTask, el checklist de la "libreta" del proyecto). Vínculo opcional: una tarea del
  // planificador puede no pertenecer a ningún proyecto.
  plannerTasks Task[]

  @@index([userId])
}

// Páginas de la "libreta" de un proyecto: contenido enriquecido (listas, imágenes embebidas
// como data URL, negrita/cursiva...) que el dashboard edita como HTML, al estilo de un
// documento de texto. Distinto de ProjectTask (los "apuntes rápidos" tipo checklist).
model ProjectPage {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String   @default("Página sin título")
  content   String   @default("") @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model ProjectTask {
  id          Int       @id @default(autoincrement())
  projectId   Int
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Hobby {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  category    String // "reading", "gaming", "music", "sports", "art"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions HobbySession[]

  @@index([userId])
}

model HobbySession {
  id              Int      @id @default(autoincrement())
  hobbyId         Int
  userId          Int
  durationMinutes Int
  date            DateTime @default(now())
  notes           String?

  hobby Hobby @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hobbyId, date])
}

// Planificador de tareas (submenú de Agenda): tablero kanban con tres columnas fijas.
// `order` es un float para poder insertar una tarea entre otras dos sin tener que
// renumerar el resto de la columna (orden = punto medio entre las tarjetas vecinas).
model Task {
  id          Int       @id @default(autoincrement())
  userId      Int
  projectId   Int? // vínculo opcional a un Project — ver comentario en Project.plannerTasks
  title       String
  description String?
  status      String    @default("todo") // "todo" | "in_progress" | "done"
  priority    String    @default("medium") // "low" | "medium" | "high"
  order       Float     @default(0)
  dueDate     DateTime? // fecha límite; dispara un recordatorio (ver notificationService.createTaskDueReminders)
  tags        String[]  @default([])
  estimatedMinutes Int? // estimación previa, en minutos
  actualMinutes    Int  @default(0) // acumulado real registrado vía POST /planner/tasks/:id/time
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subtasks Subtask[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([projectId])
}

// Checklist dentro de una tarea del planificador (subtareas). Sin `order` propio: son listas
// cortas que se reordenan poco, así que basta con el orden de creación (`id`/`createdAt`).
model Subtask {
  id        Int      @id @default(autoincrement())
  taskId    Int
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  // Cursor de sincronización (ver syncService.ts) — se edita in-place (título/completed), así
  // que necesita su propio "qué cambió desde X", a diferencia de HabitLog (solo alta/baja).
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Notas rápidas de la Agenda: apuntes sueltos sin fecha ni hora (recordatorios tipo post-it),
// distintas de los Event — no ocupan bloque en el calendario, solo una lista simple.
model Note {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // ver comentario en Subtask.updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Seguimiento de hábitos diarios (widget de Agenda, junto a Progreso de objetivos): a diferencia
// de Goal (un número acumulado hacia una meta con fecha de fin), un hábito no "se completa" — se
// repite indefinidamente y lo que importa es la racha de días seguidos marcados.
model Habit {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // ver comentario en Subtask.updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, active])
}

// Un registro = "cumplido ese día". Marcar/desmarcar es solo crear o borrar la fila del día
// (en vez de un booleano por día, así el historial completo queda disponible para la racha
// y el mapa de calor sin tener que guardar 365 filas vacías por hábito y año).
model HabitLog {
  id        Int      @id @default(autoincrement())
  habitId   Int
  userId    Int
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String // "event_reminder" | "goal_at_risk" | "task_due"
  title     String
  message   String
  relatedId Int? // eventId (series), goalId o taskId, según `type`
  // Para "event_reminder": el startTime de la ocurrencia concreta que generó el aviso
  // (los eventos recurrentes no materializan una fila por ocurrencia — ver utils/recurrence.ts —
  // así que esto es lo que distingue un recordatorio de "el lunes" de uno de "el martes siguiente").
  occurrenceAt DateTime?
  // Solo relevante para type="event_reminder": con cuántos minutos de antelación se generó ESTE
  // aviso concreto (ver Event.reminderMinutesBefore). Un evento puede tener varios avisos
  // configurados (15 min y 1 día antes, por ejemplo) para la MISMA ocurrencia — sin este campo,
  // ambos compartirían (relatedId, occurrenceAt) y la deduplicación descartaría el segundo por
  // "duplicado" cuando en realidad es un aviso distinto.
  offsetMinutesBefore Int?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([type, relatedId, occurrenceAt])
}

// Rastro de borrados para la sincronización offline del móvil (ver syncService.ts): los deletes
// de esta app son siempre hard deletes (prisma.X.delete), así que sin esto un cliente que
// llevara tiempo desconectado nunca se enteraría de que una fila desapareció — el pull de sync
// devuelve estas filas junto a los cambios normales para que el móvil borre su copia local.
// Solo cubre los modelos de la Fase 1 de sync (Event/EventException, Task/Subtask, Note,
// Habit/HabitLog) — el resto de módulos (Finanzas, Proyectos, Hobbies, Objetivos...) no
// sincroniza con el móvil todavía y sus deletes no generan tombstone.
model SyncTombstone {
  id         Int      @id @default(autoincrement())
  userId     Int
  entityType String // "event" | "eventException" | "task" | "subtask" | "note" | "habit" | "habitLog"
  entityId   Int
  deletedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}
